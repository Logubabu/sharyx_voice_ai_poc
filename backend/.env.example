HOST=0.0.0.0
PORT=8000

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# STT Configuration (sarvam, groq, openai, deepgram)
STT_PROVIDER=sarvam
STT_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v1

# LLM Configuration (google, groq, openai)
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# TTS Configuration (elevenlabs, groq, openai, cartesia)
TTS_PROVIDER=elevenlabs
TTS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*

